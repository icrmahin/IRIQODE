  ],
  "keywords": [
    "theme",
    "dark theme",
    "iridescent",
    "spectral",
    "minimal"
  ],
  "icon": "assets/extension-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/icrmahin/IRIQODE.git"
  },
  "bugs": {
    "url": "https://github.com/icrmahin/IRIQODE/issues"
  },
  "homepage": "https://github.com/icrmahin/IRIQODE#readme",
