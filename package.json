{
  "name": "iriqode",
  "displayName": "IRIQODE",
  "description": "A spectral dark theme for Visual Studio Code and Neovim.",
  "version": "0.1.0",
  "publisher": "icrmahin",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark theme",
    "iridescent",
    "spectral",
    "minimal",
    "file icons",
    "folder icons",
    "product icons",
    "neovim",
    "lazyvim",
    "colorscheme",
    "treesitter"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/icrmahin/IRIQODE.git"
  },
  "bugs": {
    "url": "https://github.com/icrmahin/IRIQODE/issues"
  },
  "homepage": "https://github.com/icrmahin/IRIQODE#readme",
  "contributes": {
    "themes": [
      {
        "label": "IRIQODE",
        "uiTheme": "vs-dark",
        "path": "./themes/iriqode-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "iriqode-file-icons",
        "label": "IRIQODE File Icons",
        "path": "./themes/iriqode-file-icons.json"
      }
    ],
    "productIconThemes": [
      {
        "id": "iriqode-product-icons",
        "label": "IRIQODE Product Icons",
        "path": "./themes/iriqode-product-icons.json"
      }
    ]
  },
  "scripts": {
    "prepare:icons": "node scripts/prepare-icons.js",
    "prevalidate": "npm run prepare:icons",
    "validate": "node scripts/validate.js",
    "package": "npm run validate && npx --yes @vscode/vsce package --no-dependencies",
    "vscode:prepublish": "npm run validate"
  },
  "icon": "assets/iriqode-icon.png"
}
