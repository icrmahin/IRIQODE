{
  "name": "iriqode",
  "displayName": "IRIQODE",
  "description": "A spectral dark theme for Visual Studio Code.",
  "version": "0.1.0",
  "publisher": "icrmahin",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
