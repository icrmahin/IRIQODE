    "gitDecoration.modifiedResourceForeground": "#F2B879",
    "gitDecoration.deletedResourceForeground": "#FF6B78",
    "gitDecoration.untrackedResourceForeground": "#73AFFF",
    "gitDecoration.ignoredResourceForeground": "#737C8D",
    "gitDecoration.conflictingResourceForeground": "#C18BDF",
    "merge.currentHeaderBackground": "#263B39",
    "merge.incomingHeaderBackground": "#302A46",
    "merge.border": "#303747",
    "diffEditor.insertedTextBackground": "#64D3DB20",
    "diffEditor.removedTextBackground": "#FF806B20"
  },
  "tokenColors": [
    { "name": "Comments", "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#737C8D", "fontStyle": "italic" } },
    { "name": "Keywords", "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#A58BFF" } },
    { "name": "Export keyword", "scope": ["keyword.control.export", "storage.modifier.export"], "settings": { "foreground": "#A58BFF" } },
    { "name": "Default keyword", "scope": ["keyword.control.default"], "settings": { "foreground": "#E995B9" } },
    { "name": "Function keyword", "scope": ["keyword.declaration.function", "storage.type.function"], "settings": { "foreground": "#72C9FF" } },
    { "name": "Strings", "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#E6A5C7" } },
    { "name": "Numbers and constants", "scope": ["constant.numeric", "constant.language"], "settings": { "foreground": "#F2B879" } },
    { "name": "Language constants", "scope": ["constant.language.boolean", "constant.language.null", "constant.language.undefined"], "settings": { "foreground": "#C18BDF" } },
    { "name": "Types and classes", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#64D9DC" } },
    { "name": "Function declarations and calls", "scope": ["entity.name.function", "support.function", "variable.function"], "settings": { "foreground": "#72C9FF" } },
    { "name": "Properties", "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"], "settings": { "foreground": "#E995B9" } },
    { "name": "Parameters", "scope": ["variable.parameter"], "settings": { "foreground": "#F39A86" } },
    { "name": "Local variables", "scope": ["variable.other.readwrite", "variable.other"], "settings": { "foreground": "#FF806B" } },
    { "name": "JSX tags", "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#FF8B75" } },
    { "name": "Operators", "scope": ["keyword.operator"], "settings": { "foreground": "#C5CAD6" } },
    { "name": "Punctuation", "scope": ["punctuation", "meta.brace"], "settings": { "foreground": "#AEB6C5" } },
    { "name": "Markup headings", "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#73AFFF", "fontStyle": "bold" } },
    { "name": "Markup emphasis", "scope": ["markup.bold"], "settings": { "foreground": "#F39A86", "fontStyle": "bold" } },
    { "name": "Markup italic", "scope": ["markup.italic"], "settings": { "foreground": "#E995B9", "fontStyle": "italic" } },
    { "name": "Markup links", "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#64D3DB", "fontStyle": "underline" } },
    { "name": "Invalid", "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#FF6B78", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "variable": "#FF806B",
    "variable.readonly": "#C18BDF",
    "parameter": "#F39A86",
    "property": "#E995B9",
    "property.readonly": "#C18BDF",
    "function": "#72C9FF",
    "method": "#73AFFF",
    "class": "#64D9DC",
    "interface": "#64D9DC",
    "type": "#64D9DC",
    "enum": "#C18BDF",
    "enumMember": "#C18BDF",
    "namespace": "#73AFFF",
    "keyword": "#A58BFF",
    "comment": {
      "foreground": "#737C8D",
      "italic": true
    },
    "string": "#E6A5C7",
    "number": "#F2B879",
    "regexp": "#F39A86",
    "operator": "#C5CAD6",
    "decorator": "#C18BDF",
    "macro": "#9294F5"
  }
}
